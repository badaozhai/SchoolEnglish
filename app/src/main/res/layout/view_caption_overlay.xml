<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/overlay_surface"
    app:cardElevation="10dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.SchoolEnglish.Small"
    app:strokeColor="@color/overlay_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/overlayHeader"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="24dp"
                android:background="@color/player_coral" />

            <TextView
                android:id="@+id/overlayTrackName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/player_time_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/overlayClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/overlay_close_background"
                android:contentDescription="关闭悬浮字幕"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                app:tint="@color/player_time_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/overlayCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="6dp"
            android:maxLines="4"
            android:minHeight="64dp"
            android:textColor="@color/blue_900"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
